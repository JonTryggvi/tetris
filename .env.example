# Copy to .env and fill in before building. .env is gitignored.
#
# API base for the leaderboard.
#   - dev:  leave as "" so calls hit "/wp-json/..." and go through the Vite proxy
#           (see vite.config.ts) to dodge localhost CORS.
#   - prod: set to "https://jontryggvi.is" so the static bundle calls the API
#           directly (tetris.silentrecorders.io is on the WP CORS allowlist).
VITE_API_BASE=

# HMAC signing secret for score submission (wp option: jt_tetris_secret),
# base64-encoded. Encode with:  printf '%s' 'THE_SECRET' | base64
# (base64 avoids dotenv's $ / # / backtick parsing mangling the raw secret.)
# HONEST CAVEAT: this ends up in the static bundle and is therefore extractable.
# The nonce + HMAC + rate-limit + plausibility checks only raise the bar against
# casual forgery — submitted scores cannot be fully trusted.
VITE_TETRIS_SECRET_B64=
